<?xml version="1.0" encoding="UTF-8"?>
<!--
  routes.rou.xml — Vehicle Routes for junction_01 SUMO Validation
  ================================================================
  Contains:
    - Vehicle type definitions (car, bus / BRTS, emergency vehicle)
    - Route definitions covering all 4 approaches
    - Normal flow demand (vehicles depart throughout the simulation)
    - Heavy / festival demand (higher volumes for festival-mode test)
    - Emergency vehicle injection (for priority validation)

  Designed for use with fixed_timer.sumocfg and adaptive_timer.sumocfg.
  Adjust departRate values to match desired load scenarios.
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ===== Vehicle Types ===== -->
    <vType id="car"
           accel="2.6" decel="4.5" sigma="0.5"
           length="4.5" minGap="2.5" maxSpeed="13.89"
           color="0.8,0.8,0.0"
           guiShape="passenger"/>

    <vType id="brts_bus"
           accel="1.5" decel="3.5" sigma="0.2"
           length="12.0" minGap="3.0" maxSpeed="11.11"
           color="0.0,0.6,1.0"
           guiShape="bus"/>

    <vType id="emergency"
           accel="3.0" decel="5.0" sigma="0.1"
           length="5.5" minGap="2.0" maxSpeed="16.67"
           color="1.0,0.0,0.0"
           guiShape="emergency"/>

    <!-- ===== Routes ===== -->
    <route id="route_NS"  edges="edge_N_in edge_S_out"/>
    <route id="route_SN"  edges="edge_S_in edge_N_out"/>
    <route id="route_EW"  edges="edge_E_in edge_W_out"/>
    <route id="route_WE"  edges="edge_W_in edge_E_out"/>

    <!-- ===== Normal Flow Demand (office_hours baseline) ===== -->
    <!-- NS heavier than EW to test max-pressure preferring NS green -->
    <flow id="flow_NS_normal" type="car" route="route_NS"
          begin="0"    end="1800" departLane="random"
          departSpeed="max" vehsPerHour="600"/>

    <flow id="flow_SN_normal" type="car" route="route_SN"
          begin="0"    end="1800" departLane="random"
          departSpeed="max" vehsPerHour="600"/>

    <flow id="flow_EW_normal" type="car" route="route_EW"
          begin="0"    end="1800" departLane="random"
          departSpeed="max" vehsPerHour="300"/>

    <flow id="flow_WE_normal" type="car" route="route_WE"
          begin="0"    end="1800" departLane="random"
          departSpeed="max" vehsPerHour="300"/>

    <!-- ===== Festival / Heavy Load (festival mode test) ===== -->
    <flow id="flow_NS_festival" type="car" route="route_NS"
          begin="1800" end="3600" departLane="random"
          departSpeed="max" vehsPerHour="1100"/>

    <flow id="flow_SN_festival" type="car" route="route_SN"
          begin="1800" end="3600" departLane="random"
          departSpeed="max" vehsPerHour="1000"/>

    <flow id="flow_EW_festival" type="car" route="route_EW"
          begin="1800" end="3600" departLane="random"
          departSpeed="max" vehsPerHour="900"/>

    <flow id="flow_WE_festival" type="car" route="route_WE"
          begin="1800" end="3600" departLane="random"
          departSpeed="max" vehsPerHour="850"/>

    <!-- ===== BRTS Bus (waiting priority test) ===== -->
    <!-- One BRTS bus departs from East at t=300 to test priority bias -->
    <vehicle id="brts_bus_01" type="brts_bus" route="route_EW"
             depart="300" departLane="0" departSpeed="0"/>

    <!-- A second bus after the first clears -->
    <vehicle id="brts_bus_02" type="brts_bus" route="route_WE"
             depart="600" departLane="0" departSpeed="0"/>

    <!-- ===== Emergency Vehicle (priority override test) ===== -->
    <!-- Ambulance enters from North at t=900 (mid-simulation) -->
    <vehicle id="ambulance_01" type="emergency" route="route_NS"
             depart="900" departLane="0" departSpeed="10"
             color="1.0,0.0,0.0"/>

</routes>
