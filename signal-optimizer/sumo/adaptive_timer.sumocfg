<?xml version="1.0" encoding="UTF-8"?>
<!--
  adaptive_timer.sumocfg — SUMO Configuration: Adaptive (Max-Pressure) Run
  =========================================================================
  Runs the simulation with TraCI enabled so that traci_runner.py can override
  the traffic-light program at each step using the max-pressure algorithm.

  The tlLogic in network.net.xml is still required as the initial state, but
  traci_runner.py will call traci.trafficlight.setPhase() / setPhaseDuration()
  every decision cycle to apply the adaptive timing.

  Outputs (separate directory from fixed run so they don't overwrite):
    - tripinfo.xml  : per-vehicle trip statistics
    - summary.xml   : per-step network-wide statistics
    - queue.xml     : per-edge queue lengths over time

  Usage (TraCI — do NOT run standalone):
    python traci_runner.py
    (traci_runner.py starts sumo with --remote-port automatically)

  For a quick visual check without running traci_runner.py:
    sumo-gui -c adaptive_timer.sumocfg   (fixed plan only, no adaptive)
-->
<configuration>

    <input>
        <net-file      value="network.net.xml"/>
        <route-files   value="routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end   value="3600"/>
        <step-length value="1"/>
    </time>

    <output>
        <tripinfo-output  value="output/adaptive_tripinfo.xml"/>
        <summary-output   value="output/adaptive_summary.xml"/>
        <queue-output     value="output/adaptive_queue.xml"/>
        <statistic-output value="output/adaptive_statistics.xml"/>
    </output>

    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="false"/>
    </report>

</configuration>
